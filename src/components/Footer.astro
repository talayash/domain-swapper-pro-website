---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mx-auto flex max-w-[1560px] flex-col gap-6 px-5 py-8 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-12">
  <div class="flex flex-wrap items-center gap-3">
    <img src="/icons/icon.svg" alt="" width="20" height="20" class="h-5 w-5" loading="lazy" />
    <span class="font-mono text-[11px] uppercase tracking-[0.13em] text-mute">Domain Swapper Pro</span>
    <span class="border border-signal-line bg-signal-soft px-2 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-signal">
      Chrome extension
    </span>
  </div>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <a href={site.chromeWebStoreUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-[11px] uppercase tracking-[0.13em] text-mute transition-colors hover:text-signal">
      Chrome Web Store
    </a>
    <a href={site.githubUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-[11px] uppercase tracking-[0.13em] text-mute transition-colors hover:text-signal">
      GitHub
    </a>
    <a href={site.issuesUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-[11px] uppercase tracking-[0.13em] text-mute transition-colors hover:text-signal">
      Issues
    </a>
    <span class="font-mono text-[11px] uppercase tracking-[0.13em] text-faint">v{site.version} · © {year}</span>
  </div>
</footer>
