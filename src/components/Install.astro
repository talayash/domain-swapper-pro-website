---
import { site } from '../data/site';
---

<section id="install" class="border-b border-rule">
  <div class="mx-auto max-w-[1560px] px-5 py-20 sm:px-8 lg:px-12 lg:py-24">

    <div class="flex flex-col gap-6 border-b border-rule pb-7 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-signal">01 / Install</span>
          <span class="block h-px w-8 bg-rule-2"></span>
          <span class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-dim">Three steps, under a minute</span>
        </div>
        <h2 class="font-display text-[clamp(2rem,4.5vw,2.875rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-ink">
          It lives in the Chrome toolbar.
        </h2>
      </div>
      <p class="max-w-[24rem] text-[15.5px] leading-[1.6] text-mute lg:shrink-0">
        No app, no account, no proxy. Domain Swapper Pro is a Manifest&nbsp;V3 extension that reads the tab
        you are on and rewrites its host.
      </p>
    </div>

    <ol class="rule-grid mt-10 grid-cols-1 md:grid-cols-3">

      <li class="flex flex-col gap-6 p-7">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px] tracking-[0.18em] text-signal">01</span>
          <span class="label">Web Store</span>
        </div>
        <div class="flex h-24 items-center justify-center gap-3.5 border border-rule bg-ground">
          <svg class="h-7 w-7 text-faint" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.819 7.555l-3.954 6.848A11.945 11.945 0 0 0 24 12c0-1.39-.236-2.725-.671-3.965H15.27zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728z"></path>
          </svg>
          <svg class="h-5 w-5 text-rule-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v13m-5-5 5 5 5-5M4 20h16" />
          </svg>
          <span class="flex h-9 w-9 items-center justify-center border border-signal-line bg-signal-soft">
            <img src="/icons/icon.svg" alt="" width="20" height="20" class="h-5 w-5" loading="lazy" />
          </span>
        </div>
        <div class="flex flex-col gap-2.5">
          <h3 class="text-[17px] font-semibold text-ink">Add it from the Chrome Web Store</h3>
          <p class="text-[14.5px] leading-[1.6] text-mute">
            Free, reviewed by Google, installed like any other extension - and available in any Chromium
            browser that accepts Web Store items.
          </p>
        </div>
      </li>

      <li class="flex flex-col gap-6 p-7">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px] tracking-[0.18em] text-signal">02</span>
          <span class="label">Toolbar</span>
        </div>
        <div class="flex h-24 items-center justify-center gap-2.5 border border-rule bg-ground">
          <svg class="h-6 w-6 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linejoin="round" d="M10.5 3.5a2 2 0 1 1 4 0V5h2.8a.7.7 0 0 1 .7.7v2.8h1.5a2 2 0 1 1 0 4H18v2.8a.7.7 0 0 1-.7.7h-2.8v1.5a2 2 0 1 1-4 0V16H7.7a.7.7 0 0 1-.7-.7v-2.8H5.5a2 2 0 1 1 0-4H7V5.7a.7.7 0 0 1 .7-.7h2.8V3.5z" />
          </svg>
          <svg class="h-4 w-4 text-rule-2" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <path d="M3 9h12M11 5l4 4-4 4" />
          </svg>
          <span class="flex h-10 w-10 items-center justify-center border border-signal-line bg-signal-soft">
            <img src="/icons/icon.svg" alt="" width="23" height="23" class="h-[23px] w-[23px]" loading="lazy" />
          </span>
        </div>
        <div class="flex flex-col gap-2.5">
          <h3 class="text-[17px] font-semibold text-ink">Pin it next to the address bar</h3>
          <p class="text-[14.5px] leading-[1.6] text-mute">
            Open Chrome’s extensions menu and pin Domain Swapper Pro. The popup then opens directly under
            the icon, on whatever tab you are looking at.
          </p>
        </div>
      </li>

      <li class="flex flex-col gap-6 p-7">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px] tracking-[0.18em] text-signal">03</span>
          <span class="label">Shortcut</span>
        </div>
        <div class="flex h-24 items-center justify-center gap-2 border border-rule bg-ground">
          <span class="keycap">Alt</span>
          <span class="font-mono text-[13px] text-faint">+</span>
          <span class="keycap keycap-signal">D</span>
        </div>
        <div class="flex flex-col gap-2.5">
          <h3 class="text-[17px] font-semibold text-ink">Swap without touching the mouse</h3>
          <p class="text-[14.5px] leading-[1.6] text-mute">
            Alt&#8239;+&#8239;D opens the popup; Alt&#8239;+&#8239;Shift&#8239;+&#8239;D jumps straight to the
            last domain you used. Rebind both in Chrome’s shortcut settings.
          </p>
        </div>
      </li>
    </ol>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={site.chromeWebStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        <svg class="h-[19px] w-[19px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.819 7.555l-3.954 6.848A11.945 11.945 0 0 0 24 12c0-1.39-.236-2.725-.671-3.965H15.27zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728z"></path>
        </svg>
        Add to Chrome
      </a>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-dim">Free · v{site.version} · Manifest V3</span>
    </div>
  </div>
</section>
