---
import { site } from '../data/site';

const capabilities = [
  "Nested folders",
  "Chrome sync",
  "Keyboard shortcuts",
  "Per-domain protocol",
  "Import / export",
  "Manifest V3",
];
---

<section id="top" class="relative border-b border-rule pt-17">
  <div class="mx-auto flex max-w-[1560px] flex-col items-start gap-12 px-5 py-14 sm:px-8 lg:flex-row lg:items-center lg:gap-14 lg:px-12 lg:py-20">

    <div class="flex w-full flex-col gap-6 lg:w-[520px] lg:shrink-0 xl:w-[560px]">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="block h-1.5 w-1.5 bg-signal"></span>
        <span class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-mute">Chrome Web Store</span>
        <span class="block h-2.5 w-px bg-rule-2"></span>
        <span class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-mute">Manifest V3</span>
        <span class="block h-2.5 w-px bg-rule-2"></span>
        <span class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-mute">v{site.version}</span>
      </div>

      <h1 class="font-display text-[clamp(2.25rem,5.2vw,3.375rem)] font-extrabold leading-[0.96] tracking-[-0.035em] text-ink">
        Swap the domain.<br /><span class="text-signal">Keep the path.</span>
      </h1>

      <p class="max-w-[30rem] text-[17px] leading-[1.62] text-mute sm:text-[17.5px]">
        A Chrome extension that sits in your toolbar. One click - or Alt&#8239;+&#8239;D - moves the current
        tab between local, staging, QA and production, carrying the full path and query string across untouched.
      </p>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={site.chromeWebStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <svg class="h-[19px] w-[19px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.819 7.555l-3.954 6.848A11.945 11.945 0 0 0 24 12c0-1.39-.236-2.725-.671-3.965H15.27zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728z"></path>
          </svg>
          Add to Chrome
        </a>
        <a href={site.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <svg class="h-[17px] w-[17px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
          </svg>
          Source
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-dim">Free</span>
        <span class="block h-2.5 w-px bg-rule-2"></span>
        <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-dim">No account</span>
        <span class="block h-2.5 w-px bg-rule-2"></span>
        <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-dim">Minimal permissions</span>
      </div>
    </div>

    <!-- Fig. 01: the toolbar the extension lives in, and what one click does to the URL. -->
    <section class="panel w-full min-w-0 shadow-[0_40px_90px_rgba(0,0,0,0.55)] lg:flex-1">
      <div class="panel-head">
        <span class="label">Fig. 01 - Environment swap</span>
        <span class="label label-signal">Alt + D</span>
      </div>

      <div class="flex flex-col gap-5 p-4 sm:p-6">

        <div class="flex items-center gap-3 border border-rule bg-panel-2 p-2.5 sm:p-3">
          <div class="hidden shrink-0 gap-1.5 sm:flex">
            <span class="block h-2 w-2 rounded-full bg-rule-2"></span>
            <span class="block h-2 w-2 rounded-full bg-rule-2"></span>
            <span class="block h-2 w-2 rounded-full bg-rule-2"></span>
          </div>
          <div class="flex h-8 min-w-0 flex-1 items-center overflow-hidden rounded-full border border-rule bg-ground px-3.5 font-mono text-[11.5px] whitespace-nowrap">
            <span class="text-dim">https://</span><span class="text-source">app.localhost:3000</span><span class="truncate text-ink">/orders/8241?tab=items</span>
          </div>
          <div class="flex shrink-0 items-center gap-2.5">
            <svg class="hidden h-[18px] w-[18px] sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" style="color:#7e8994">
              <path stroke-linejoin="round" d="M10.5 3.5a2 2 0 1 1 4 0V5h2.8a.7.7 0 0 1 .7.7v2.8h1.5a2 2 0 1 1 0 4H18v2.8a.7.7 0 0 1-.7.7h-2.8v1.5a2 2 0 1 1-4 0V16H7.7a.7.7 0 0 1-.7-.7v-2.8H5.5a2 2 0 1 1 0-4H7V5.7a.7.7 0 0 1 .7-.7h2.8V3.5z" />
            </svg>
            <span class="flex h-8 w-8 items-center justify-center border border-signal-line bg-signal-soft">
              <img src="/icons/icon.svg" alt="Domain Swapper Pro toolbar icon" width="19" height="19" class="h-[19px] w-[19px]" />
            </span>
          </div>
        </div>

        <div class="flex flex-col gap-6 xl:flex-row xl:items-start xl:gap-6">

          <div class="flex min-w-0 flex-1 flex-col">
            <span class="label pb-2">Current</span>
            <div class="border border-rule bg-ground p-3 font-mono text-[11.5px] leading-relaxed break-all">
              <span class="text-dim">https://</span><span class="border-b border-dashed border-source text-source">app.localhost:3000</span><span class="text-ink">/orders/8241?tab=items</span>
            </div>

            <div class="connector"></div>

            <div class="border border-rule bg-panel">
              <div class="flex items-center justify-between border-b border-rule px-3 py-2">
                <span class="label">Saved domains</span>
                <span class="label">Folder “Acme”</span>
              </div>
              <div class="flex items-center gap-3 px-3 py-2.5">
                <span class="block h-1.75 w-1.75 shrink-0 bg-source"></span>
                <span class="w-14 shrink-0 font-mono text-[9.5px] uppercase tracking-[0.14em] text-dim">Staging</span>
                <span class="min-w-0 flex-1 truncate font-mono text-[12px] text-mute">staging.acme.dev</span>
              </div>
              <div class="flex items-center gap-3 border-t border-rule px-3 py-2.5">
                <span class="block h-1.75 w-1.75 shrink-0 bg-[#c9a2ff]"></span>
                <span class="w-14 shrink-0 font-mono text-[9.5px] uppercase tracking-[0.14em] text-dim">QA</span>
                <span class="min-w-0 flex-1 truncate font-mono text-[12px] text-mute">qa.acme.dev</span>
              </div>
              <div class="flex items-center gap-3 border-t border-signal-line bg-signal-soft px-3 py-2.5">
                <span class="block h-1.75 w-1.75 shrink-0 bg-signal"></span>
                <span class="w-14 shrink-0 font-mono text-[9.5px] uppercase tracking-[0.14em] text-signal">Prod</span>
                <span class="min-w-0 flex-1 truncate font-mono text-[12px] text-signal">app.acme.com</span>
                <svg class="h-3 w-3 shrink-0 text-signal" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                  <path d="M2 7h10M8 3l4 4-4 4" />
                </svg>
              </div>
            </div>

            <div class="connector"></div>

            <span class="label label-signal pb-2">Result</span>
            <div class="border border-signal-line bg-signal-soft p-3 font-mono text-[11.5px] leading-relaxed break-all">
              <span class="text-dim">https://</span><span class="border-b border-signal text-signal">app.acme.com</span><span class="text-ink">/orders/8241?tab=items</span>
            </div>

            <div class="flex items-center gap-2.5 pt-2.5">
              <svg width="52" height="7" viewBox="0 0 52 7" fill="none" stroke="currentColor" stroke-width="1" class="shrink-0 text-rule-2" aria-hidden="true">
                <path d="M.5 0v6M51.5 0v6M.5 6h51" />
              </svg>
              <span class="font-mono text-[9.5px] uppercase tracking-[0.16em] text-mute">Path and query preserved</span>
            </div>
          </div>

          <div class="flex shrink-0 flex-col items-center xl:items-end">
            <div class="flex items-center gap-2 pb-2">
              <svg class="h-2.5 w-2.5 text-signal" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                <path d="M6 11V2M2.5 5.5 6 2l3.5 3.5" />
              </svg>
              <span class="font-mono text-[9.5px] uppercase tracking-[0.18em] text-signal">Pinned in your toolbar</span>
            </div>
            <img
              src="/screenshots/popup.png"
              alt="The Domain Swapper Pro popup, listing saved domains grouped into folders"
              width="359"
              height="421"
              class="block w-full max-w-[320px] border border-rule"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="border-t border-rule">
    <div class="mx-auto flex max-w-[1560px] flex-wrap items-center gap-x-5 gap-y-3 px-5 py-6 sm:px-8 lg:px-12">
      <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-signal">Capabilities</span>
      <span class="block h-3 w-px bg-rule-2"></span>
      {capabilities.map((item, i) => (
        <>
          {i > 0 && <span class="block h-3 w-px bg-rule-2"></span>}
          <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-mute">{item}</span>
        </>
      ))}
    </div>
  </div>
</section>
