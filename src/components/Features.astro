---
import features from '../data/features.json';
import { site } from '../data/site';

const iconMap: Record<string, string> = {
  swap: `<svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>`,
  folder: `<svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>`,
  keyboard: `<svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3C7.03 3 3 7.03 3 12s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9zm0 0v9l6 3"/></svg>`,
  shield: `<svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  transfer: `<svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>`,
  sync: `<svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
};
---

<section id="features" class="border-b border-rule">
  <div class="mx-auto max-w-[1560px] px-5 py-20 sm:px-8 lg:px-12 lg:py-24">

    <div class="flex flex-col gap-6 border-b border-rule pb-7 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-signal">02 / Features</span>
          <span class="block h-px w-8 bg-rule-2"></span>
          <span class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-dim">Six, and no dashboard</span>
        </div>
        <h2 class="font-display text-[clamp(2rem,4.5vw,2.875rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-ink">
          Built for six environments<br class="hidden sm:block" /> and one browser.
        </h2>
      </div>
      <a
        href={site.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="border-b border-rule-2 pb-1.5 font-mono text-[11px] uppercase tracking-[0.14em] text-mute transition-colors hover:border-signal hover:text-signal lg:shrink-0"
      >
        Read the source
      </a>
    </div>

    <div class="rule-grid mt-10 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <article class="flex flex-col gap-4 p-7">
          <span class="text-signal"><Fragment set:html={iconMap[feature.icon]} /></span>
          <h3 class="text-[17px] font-semibold text-ink">{feature.title}</h3>
          <p class="text-[14.5px] leading-[1.6] text-mute">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
