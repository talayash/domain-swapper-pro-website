---
import { site } from '../data/site';
---

<section id="download" class="border-b border-rule">
  <div class="mx-auto max-w-[1560px] px-5 py-20 sm:px-8 lg:px-12 lg:py-24">
    <div class="relative border border-signal-line bg-panel px-6 py-14 sm:px-12 sm:py-16">
      <span class="absolute left-3.5 top-3 font-mono text-[10px] uppercase tracking-[0.2em] text-signal">04 / Install</span>
      <span class="absolute right-3.5 top-3 hidden font-mono text-[10px] uppercase tracking-[0.2em] text-dim sm:block">Chrome Web Store</span>

      <div class="flex flex-col items-center gap-6 text-center">
        <h2 class="font-display text-[clamp(2.25rem,6vw,3.625rem)] font-extrabold leading-none tracking-[-0.035em] text-ink">
          Add it to Chrome.
        </h2>
        <p class="max-w-[34rem] text-[16.5px] leading-[1.6] text-mute">
          Installing takes about ten seconds and your first swap takes one click. Nothing leaves the browser.
        </p>

        <a href={site.chromeWebStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-2 h-[3.625rem] px-8 text-[14px]">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.819 7.555l-3.954 6.848A11.945 11.945 0 0 0 24 12c0-1.39-.236-2.725-.671-3.965H15.27zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728z"></path>
          </svg>
          Add to Chrome - free
        </a>

        <!-- Proof line: drop the real Web Store rating and install count in here once the listing has them. -->
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-dim">No account</span>
          <span class="block h-2.5 w-px bg-rule-2"></span>
          <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-dim">Minimal permissions</span>
          <span class="block h-2.5 w-px bg-rule-2"></span>
          <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-dim">Open source</span>
        </div>
      </div>
    </div>
  </div>
</section>
